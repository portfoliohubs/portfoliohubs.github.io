# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GitHub CDN & Upload Config (No Firebase Storage needed!)
VITE_GITHUB_USERNAME="portfoliohubs"
VITE_GITHUB_MAIN_REPO="portfoliohubs.github.io"
# Optional PAT for uploading images via GitHub Actions workflow_dispatch:
VITE_GITHUB_PAT="ghp_yourPersonalAccessTokenHere"

# Firebase Config (Auth & Firestore only - Spark Free Plan)
VITE_FIREBASE_API_KEY="AIzaSyD02aD4-o-ZKKWPg_IKLGFFxmDOMg20y2g"
VITE_FIREBASE_AUTH_DOMAIN="portfoliohubs-update.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="portfoliohubs-update"
